{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "docs/.vitepress/theme/**/*",
    "docs/**/*.ts",
    "docs/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "docs/**/*.vue"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["docs/.vitepress/theme/*"]
    }
  }
}